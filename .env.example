# Application
NODE_ENV=DEVELOPMENT
PORT=3000
API_PREFIX=api

# CORS Policy
CORS_ORIGINS=

# Auth JWT
JWT_SECRET=<Your JWT SHA-256 Secret key>
JWT_EXPIRED_TIME=1d

REFRESH_TOKEN_COOKIE=refreshToken
REFRESH_TOKEN_MAX_AGE=7d

# Redis Cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=<Your Redis password>

# Postgres DB
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=<Your DB password>
DB_DATABASE=database

DB_URL=postgresql://postgres:<Your DB password>@127.0.0.1:5432/database

# S3 Object Storage
S3_HOST=127.0.0.1
S3_PORT=9000
S3_USERNAME=admin
S3_PASSWORD=<Your S3 password>
S3_REGION=us-east-1
S3_USE_SSL=false

ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@example.com
